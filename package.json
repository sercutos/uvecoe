{
  "name": "uvecoe",
  "version": "1.0.0",
  "description": "UVECOE - Evaluación ECOE con soporte offline",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "electron:dev:clean": "wait-on tcp:5173 && cross-env NODE_ENV=development RESET_DB=true electron .",
    "start": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev\" \"npm:electron:dev\"",
    "start:clean": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev\" \"npm:electron:dev:clean\"",
    "build": "vite build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-win-signed.ps1",
    "dev:clean": "npm run start:clean",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.uv.ecoe",
    "productName": "UVECOE",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "src/db/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "artifactName": "UVECOE-${version}-setup.${ext}",
    "win": {
      "icon": "assets/images/icono.png",
      "forceCodeSigning": true,
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UVECOE"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electronmon": "^2.0.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "knex": "^3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  }
}
